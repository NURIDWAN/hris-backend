# ==============================================================================
# GajiPro - Environment Configuration for Database Cluster
# ==============================================================================
APP_NAME=GajiPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database Connection (Menghubungkan ke HAProxy Galera Cluster)
# ------------------------------------------------------------------------------
# DB_HOST diarahkan ke service HAProxy 'db-cluster' (di Docker network bersama)
# atau '127.0.0.1' jika diakses langsung dari host machine.
DB_CONNECTION=mariadb
DB_HOST=db-cluster
DB_PORT=3306
DB_DATABASE=gajipro
DB_USERNAME=gajipro
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Optional: Read-Only Pool Port (bila menggunakan read-write split di Laravel)
DB_READ_PORT=3308

# ------------------------------------------------------------------------------
# Redis Cache, Session, & Queue
# ------------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Port Mappings Host
# ------------------------------------------------------------------------------
FORWARD_APP_PORT=8000
FORWARD_DB_PORT=3307          # Host port ke HAProxy Primary
FORWARD_DB_RO_PORT=3308       # Host port ke HAProxy Read-Only pool
FORWARD_DB_STATS_PORT=8404    # Host port ke HAProxy Web Stats Dashboard
FORWARD_REDIS_PORT=6380
