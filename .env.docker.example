APP_NAME=GajiPro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MariaDB Container)
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=gajipro
DB_USERNAME=gajipro
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Session, Cache, & Queue (Redis Container)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
FILESYSTEM_DISK=local

# Host Port Mappings (bisa disesuaikan jika ingin port lain)
FORWARD_APP_PORT=8000
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380
